# Copy to .env for local runs (Render uses its own environment variables UI).

# Port the relay listens on. Render injects this automatically.
PORT=8080

# Optional: restrict which sites may connect.
# ALLOWED_ORIGINS=https://your-user.github.io,http://localhost:5173

# Optional: enables the Library view (owned games for a public Steam profile).
# Create one at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# Tuning (all optional)
# STEAM_CONCURRENCY=4          # simultaneous outbound requests to Steam
# STEAM_MIN_GAP_MS=80          # minimum gap between outbound requests
# REST_LIMIT_PER_MIN=180       # per-IP limit on /api/*
# WS_LIMIT_PER_WINDOW=60       # per-socket messages per 10s
# LIVE_INTERVAL_MS=120000      # most-played broadcast interval
# PLAYERS_INTERVAL_MS=60000    # subscribed player-count refresh interval
